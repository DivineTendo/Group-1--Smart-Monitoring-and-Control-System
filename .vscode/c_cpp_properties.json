{
    "configurations": [
        {
            "name": "PlatformIO",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "${env:USERPROFILE}/.platformio/packages/framework-espidf@3.50301.0/components/**"
            ],
            "defines": [
                "ESP_PLATFORM",
                "IDF_VER=\"v5.3.1\"",
                "CONFIG_IDF_TARGET_ESP32",
                "CONFIG_IDF_TARGET=\"esp32\"",
                "CONFIG_FREERTOS_HZ=100",
                "CONFIG_LOG_MAXIMUM_LEVEL=3"
            ],
            "compilerPath": "${env:USERPROFILE}/.platformio/packages/toolchain-xtensa-esp-elf/bin/xtensa-esp32-elf-gcc.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}
